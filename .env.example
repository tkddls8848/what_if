# 이 파일을 .env로 복사해서 쓴다 (`.env`는 .gitignore에 있어 커밋되지 않는다).
# 실제 값을 이 .env.example 파일에는 절대 채우지 말 것 — 이 파일은 커밋된다.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env는 선택 사항이고, 실제 환경변수($env:로 넣었거나 CI/배포가 주입한 값)가
# 항상 이 파일의 값보다 우선한다.

# --- /play (인터랙티브 소설): 필수 ---

# Cloudflare 대시보드 > 계정 홈 우측 사이드바에서 확인하는 Account ID.
CF_ACCOUNT_ID=

# Cloudflare 대시보드 > My Profile > API Tokens에서 발급하는 API 토큰.
# "Workers AI" 템플릿으로 만들면 아래 두 권한이 함께 부여된다.
#   - Workers AI - Read
#   - Workers AI - Edit
CF_API_TOKEN=

# Workers AI 호출 타임아웃(ms). 선택 사항, 기본값 120000(120초).
CF_TIMEOUT_MS=

# --- Gemini 무료 티어 폴백: 선택 사항 ---
#
# Cloudflare의 하루 무료 할당(10,000 Neurons)이 마르면 서술을 Gemini로 이어
# 받는다. 비워 두면 폴백 없이 지금까지와 똑같이 동작한다(Cloudflare만 쓴다).
# 반대로 CF_* 없이 이것만 채우면 Gemini 단독으로도 돈다.
#
# 두 무료 할당은 재는 단위가 다르다 — Cloudflare는 토큰량(Neurons), Gemini는
# 요청 수(RPD/RPM)다. 그래서 토큰을 먼저 다 쓰고 요청 수로 넘어가는 순서가
# 하루에 칠 수 있는 턴 수를 가장 크게 만든다(server.js의 getNarrationClient 참고).
# 장면 이미지에는 폴백이 없다 — 그림은 Cloudflare 전용이다.

# aistudio.google.com > Get API key에서 발급한다. 신용카드 없이 무료 티어로 쓸 수 있다.
GEMINI_API_KEY=

# 기본값 gemini-2.5-flash. 무료 티어는 Flash·Flash-Lite 계열만 지원한다.
# 하루 요청 한도(RPD)는 모델마다 다르고 자주 바뀌므로, 실제 한도는 AI Studio
# 콘솔에서 확인한다 — 더 큰 한도를 주는 Flash 모델이 있으면 여기에 그 이름을
# 넣으면 된다. 코드는 모델 이름 형식만 검사하고 내용은 Gemini에 맡긴다.
GEMINI_MODEL=

# Gemini 호출 타임아웃(ms). 비우면 CF_TIMEOUT_MS를, 그것도 없으면 120000을 쓴다.
GEMINI_TIMEOUT_MS=

# --- 장면 배경 이미지: 선택 사항 ---
#
# 세 모델 중 하나를 고른다. 비용은 (타일당 단가 + 스텝당 단가 × 스텝 수)로,
# 512×512 이미지 한 장(타일 1장) 기준:
#   @cf/black-forest-labs/flux-1-schnell  약 43.2 Neurons — 4스텝 증류 모델.
#     속도를 사려고 프롬프트 순응도를 버린다. "교실, 밤, 비"라고 써도 그
#     내용을 잘 안 지킨다 — 가장 싸지만 이 앱의 요구(내용 충실도)에는 안 맞는다.
#   @cf/leonardo/phoenix-1.0  약 730 Neurons — flux보다 ~17배 비싸지만
#     "프롬프트 순응도가 뛰어나다"고 Cloudflare가 명시한 모델이고, 이 셋 중
#     유일하게 negative_prompt(부정 프롬프트)를 받는다. 기본값.
#   @cf/leonardo/lucid-origin  약 876 Neurons — "가장 프롬프트에 반응적"이라고
#     Cloudflare가 명시하지만 phoenix보다 비싸고 negative_prompt가 없다.
# 해상도보다 내용 충실도가 중요하면 phoenix, 그래도 비용을 더 낮추고 싶으면
# flux, phoenix보다 더 순응도를 쥐어짜야 하면 lucid를 고려한다. 무료 할당은
# 하루 10,000 Neurons다 — phoenix 기준 하루 약 13장, flux 기준 약 230장.
# 레지스트리에 없는 값을 넣으면 조용히 기본값으로 넘어가지 않고 요청이
# INVALID_ARGUMENT로 실패한다(src/llm/image.js 참고).
IMAGE_MODEL=

# 생성 크기(px). flux-1-schnell은 이 값을 받지 않는다(고정 크기). 기본값
# 512×512는 Cloudflare 타일(512×512) 1장이라 1024×1024(타일 4장)의 1/4
# 비용이다 — 이 앱은 해상도보다 내용을 우선하므로 이 크기를 기본으로 둔다.
IMAGE_WIDTH=
IMAGE_HEIGHT=

# --- 장면 판정(미술감독): Jev ---

# /play의 배경 그림은 "지금 어디인가"를 매 턴 판정해서 장면이 바뀔 때만 다시
# 그린다. 그 판정을 TypeSafe Jev(typesafe/jev)가 한다 — 세계관 파일의
# world.stage에 적힌 닫힌 목록 안에서만 고르므로 목록 밖 답이 구조적으로 나올 수
# 없다. 자격증명은 위의 CF_ACCOUNT_ID/CF_API_TOKEN을 그대로 쓴다.
#
# **주의: Jev는 Workers AI 하루 무료 할당(10,000 Neurons) 밖이다.** 서드파티
# 모델이라 AI Gateway 통합 과금으로 계산된다. 게이트웨이에 선불 크레딧이 없으면
# 매 호출이 402(code 2021)로 떨어지고, 그 턴은 장면을 유지한 채 그냥 성공한다 —
# 배경 그림 하나 때문에 턴을 잃지 않는다. 단가는 입력 토큰 기준이고 한 턴에 약
# 600~700 입력 토큰이 든다(출력은 무료).

# AI Gateway를 거쳐 보낼 때의 게이트웨이 이름. 채우면 로그·캐시·레이트리밋·BYOK가
# 그 게이트웨이에 붙는다. 비워 두면 v4 통합 엔드포인트로 직접 간다 — 둘은 URL만
# 다르고 바디·응답 계약이 같다. 게이트웨이는 Cloudflare 대시보드의 AI > AI Gateway
# 에서 만든다(만들지 않은 이름을 넣으면 401이 온다).
CF_GATEWAY_ID=

# 게이트웨이에 "Authenticated Gateway"를 켰을 때만 필요한 게이트웨이 토큰.
# 안 켰으면 비워 둔다. CF_GATEWAY_ID가 비어 있으면 이 값은 쓰이지 않는다.
CF_AIG_TOKEN=

# 장면 판정 호출 타임아웃(ms). 기본값 30000. 서술(120초)보다 훨씬 짧은 것은
# 의도다 — 독자는 이미 서술과 선택지를 다 받았고, 이건 그 위에 늦게 얹히는
# 배경 그림 하나를 위한 호출이라 오래 매달릴 이유가 없다.
JEV_TIMEOUT_MS=

# 장면을 바꾸는 신뢰도 임계. 기본값 0.7. 장소·시간·날씨 세 답이 모두 이 값
# 이상일 때만 그림을 다시 그린다 — 하나라도 미달이면 장면을 유지한다("모르면
# 바꾸지 않는다": 잘못 바꾸면 틀린 그림이 걸리고, 안 바꾸면 조금 낡은 그림이
# 걸린다. 후자가 덜 나쁘다).
SCENE_CONFIDENCE=

# --- 소설 분석기 (/analyze, /check): 선택 사항 ---

# 서버가 열리는 포트. 기본값 3000.
PORT=

# 상세 분석·what-if 생성에 쓰는 Ollama 서버 주소. 기본값 http://127.0.0.1:11434.
OLLAMA_URL=

# Ollama 호출 타임아웃(ms). 선택 사항, 기본값 120000(120초).
OLLAMA_TIMEOUT_MS=
