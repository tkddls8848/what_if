{
  "name": "novel-if",
  "version": "0.1.0",
  "description": "Interactive timeline visualization for published novels",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node --no-warnings mcp/server.js",
    "audit": "node --no-warnings scripts/audit_report.mjs",
    "eval": "node --no-warnings scripts/eval_extraction.mjs",
    "eval:qa": "node --no-warnings scripts/eval_asof_qa.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
